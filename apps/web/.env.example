# Minimum runtime
POSTGRES_URL=
BETTER_AUTH_SECRET=

# Stable production origin (required for launch; include https://)
BETTER_AUTH_URL=

# Production rate limiting (configure one; KV_URL is a supported fallback)
REDIS_URL=
KV_URL=

# Vercel OAuth (required for sign-in)
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# GitHub App (required for repo access, pushes, and PRs)
# Callback URL: {YOUR_ORIGIN}/api/auth/callback/github (better-auth)
# Setup URL:    {YOUR_ORIGIN}/api/github/app/callback (installation sync)
# In the GitHub App settings:
#   1. Use the GitHub App Client ID and Client Secret below
#   2. Make the app public if you want org installs to work cleanly
#   3. Store the private key either as PEM contents with escaped newlines
#      or as a base64-encoded PEM
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Optional integrations
ELEVENLABS_API_KEY=

# Optional deployment refinements
# Set to "hobby" to use lower resource defaults for constrained deployments.
# Leave unset for standard behavior.
OPEN_AGENTS_RESOURCE_PROFILE=
VERCEL_PROJECT_PRODUCTION_URL=
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
# Optional base snapshot for fresh sandboxes. If unset, sandboxes use Vercel's standard Sandbox runtime.
# Use a snapshot created in/accessible to your own Vercel scope.
VERCEL_SANDBOX_BASE_SNAPSHOT_ID=
# Comma-separated extra npm-compatible registry hostnames. The public npm
# registry is allowed by default only during approved dependency installs.
SANDBOX_NPM_REGISTRY_DOMAINS=registry.npmjs.org

# Experimental only. Do not set this for the supported apps/web deployment.
NEXT_PUBLIC_CONTROL_PLANE_URL=

# Optional OpenAI-compatible provider for open-weight or self-hosted models
# (Kimi, DeepSeek, Qwen, GLM, etc.). Set all three or leave all three empty.
# Setting only one or two is ignored.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# JSON array of model descriptors. Example:
# Models are hidden unless enabled=true and capabilities.tools=true.
# OPENAI_COMPATIBLE_MODELS='[{"id":"moonshotai/kimi-k2.5","name":"Kimi K2.5","contextWindow":131072,"enabled":true,"capabilities":{"tools":true,"vision":false,"reasoning":true}}]'
OPENAI_COMPATIBLE_MODELS=
